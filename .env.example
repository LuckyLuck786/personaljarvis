# ============================================================
# JARVIS secrets & overrides.
# Copy to .env (chmod 600) and fill in. NEVER commit .env.
# `jarvis keygen` generates the two core keys for you.
# ============================================================

# --- Core secrets (required) ---------------------------------
# API key required by every hub HTTP endpoint (X-API-Key header).
JARVIS_API_KEY=
# Master key for at-rest encryption of memory content (Fernet, 32-byte
# urlsafe base64). Losing this key means losing encrypted memories — back
# it up somewhere safe OUTSIDE the hub.
JARVIS_MASTER_KEY=

# --- Telegram (Phase 1) --------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to JARVIS.
# Everyone else is ignored and logged.
TELEGRAM_ALLOWED_USER_IDS=

# --- Cloud fallback tiers (optional; router skips unset ones) -
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# --- Optional overrides (defaults shown) ---------------------
# JARVIS_DATA_DIR=~/.jarvis
# JARVIS_CONFIG=config/jarvis.yaml
# JARVIS_HUB_URL=http://127.0.0.1:8700
# JARVIS_LOG_LEVEL=INFO
# JARVIS_LOG_PRETTY=0
